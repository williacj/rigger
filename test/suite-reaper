// ABOUTME: Ends a test run's processes after its suite shell closes a pipe, even if that shell was killed.

import { spawnSync } from 'node:child_process';
import { createReadStream } from 'node:fs';
import { realpathSync } from 'node:fs';
import { join } from 'node:path';
import { closeSync, constants as files, existsSync, lstatSync, openSync, statSync, writeSync } from 'node:fs';
import { dirname, isAbsolute, relative, resolve, sep } from 'node:path';
import { targetReadRecord } from './suite-reaper-probe.mjs';

import { removeTemporaryDirectory } from './temporary-directory.mjs';
import { SWEEPS } from './process-fixtures.mjs';
import { LSOF } from '../src/substrate/process.mjs';

const [directory, pipe] = process.argv.slice(2);
const run = realpathSync.native(directory);
const marker = join(run, 'runner.cjs');

function read(command, args) {
  const result = spawnSync(command, args, { cwd: '/', env: process.env, encoding: 'utf8', maxBuffer: Infinity });
  if (result.error || (result.status !== 0 && !(result.status === 1 && result.stdout === ''))) {
    throw new Error(`${command} ${args.join(' ')} failed: ${result.error?.message ?? result.stderr}`);
  }
  return result.stdout;
}

let completedReads = 0;
let lostWrite = false;

function appendTrace(record) {
  const destination = process.env.RIGGER_REAPER_TRACE_FILE;
  if (!destination) return;
  try {
    const temporary = process.env.RIGGER_REAPER_TRACE_ROOT;
    if (!temporary || !isAbsolute(temporary) || !isAbsolute(destination)) throw new Error('trace destination is not absolute');
    const root = realpathSync.native(temporary);
    const parent = realpathSync.native(dirname(destination));
    const distance = relative(root, parent);
    if (distance === '..' || distance.startsWith(`..${sep}`) || isAbsolute(distance)) throw new Error('trace destination is outside TMPDIR');
    if (statSync(root).uid !== process.getuid() || statSync(parent).uid !== process.getuid()) throw new Error('trace destination is not owned');
    for (let directory = parent; ; directory = dirname(directory)) {
      if (existsSync(join(directory, '.git'))) throw new Error('trace destination is inside a checkout');
      if (directory === dirname(directory)) break;
    }
    try {
      if (lstatSync(destination).isSymbolicLink()) throw new Error('trace destination is a link');
    } catch (error) {
      if (error.code !== 'ENOENT') throw error;
    }
    const line = `${JSON.stringify(record)}\n`;
    const descriptor = openSync(resolve(destination), files.O_CREAT | files.O_APPEND | files.O_WRONLY | files.O_NOFOLLOW, 0o600);
    try {
      if (writeSync(descriptor, line) !== Buffer.byteLength(line)) lostWrite = true;
    } finally { closeSync(descriptor); }
  } catch {
    // Losing observation must never change the reaper's confirmed-ending decision.
    lostWrite = true;
  }
}

function finishTrace() {
  const cell = process.env.RIGGER_REAPER_CELL;
  appendTrace({ type: 'terminal', cell: /^(?:E[56]-F[1-7]|E4-F6)$/.test(cell) ? cell : 'other', completedReads, lostWrite });
}

function targetState(pid) {
  const result = spawnSync('/bin/ps', ['-ww', '-p', String(pid), '-o', 'pid=,stat=,lstart=,command='], {
    cwd: '/', env: { ...process.env, LC_ALL: 'C', TZ: 'UTC0' }, encoding: 'utf8', maxBuffer: Infinity,
    timeout: 1_000, killSignal: 'SIGKILL',
  });
  let parserClass = 'read-failed';
  let signalZero = 'not-checked';
  try {
    if (result.error || result.signal !== null || typeof result.stdout !== 'string' || result.stderr !== ''
        || (result.status !== 0 && !(result.status === 1 && result.stdout === ''))) {
      throw new Error(`target ${pid} ending read failed: status=${result.status} signal=${result.signal} error=${result.error?.code ?? ''} stderr=${JSON.stringify(result.stderr)}`);
    }
    if (result.stdout === '') {
      try { process.kill(pid, 0); signalZero = 'reached'; }
      catch (error) {
        signalZero = error.code === 'ESRCH' || error.code === 'EPERM' ? error.code : 'other';
        if (error.code === 'ESRCH') {
          parserClass = 'absent';
          return { absent: true };
        }
        parserClass = 'absence-unconfirmed';
        throw new Error(`target ${pid} absence is unconfirmed: ${error.code ?? error.message}`);
      }
      parserClass = 'omitted';
      throw new Error(`target ${pid} was omitted while signal zero still reaches it`);
    }
    // One physical Unix row only. Do not trim away blank rows or accept vertical separators.
    const line = result.stdout.endsWith('\n') ? result.stdout.slice(0, -1) : result.stdout;
    if (/[\n\r\v\f\u0085\u2028\u2029]/.test(line)) {
      parserClass = 'framing';
      throw new Error(`target ${pid} ending read has invalid row framing`);
    }
    const row = /^[ \t]*([0-9]+)[ \t]+([A-Zt][A-Za-z+<>]*)[ \t]+([A-Za-z]{3} [A-Za-z]{3} [ 0-9][0-9] [0-9]{2}:[0-9]{2}:[0-9]{2} [0-9]{4})(?:[ \t]+(.*))?[ \t]*$/.exec(line);
    if (result.status !== 0 || !row || !Number.isSafeInteger(Number(row[1])) || Number(row[1]) !== pid) {
      parserClass = 'malformed';
      throw new Error(`target ${pid} ending read was malformed or ambiguous`);
    }
    parserClass = row[2].startsWith('Z') ? 'zombie' : 'live';
    return { started: row[3], zombie: row[2].startsWith('Z') };
  } finally {
    completedReads += 1;
    try {
      appendTrace(targetReadRecord({
        cell: process.env.RIGGER_REAPER_CELL,
        pid, readSequence: completedReads, parserClass, signalZero, result,
      }));
    } catch {
      lostWrite = true;
    }
  }
}

function inside(path) {
  if (path !== run && !path.startsWith(`${run}/`)) return false;
  let resolved;
  try {
    resolved = realpathSync.native(path);
  } catch {
    // A process still working in a removed part of this run must not be treated as gone.
    return true;
  }
  return resolved === run || resolved.startsWith(`${run}/`);
}

function processes() {
  const rows = new Map();
  for (const line of read('/bin/ps', ['-U', String(process.getuid()), '-o', 'pid=,ppid=,stat=,command=']).split('\n')) {
    const row = /^\s*(\d+)\s+(\d+)\s+(\S+)\s+(.*)$/.exec(line);
    if (row && !row[3].startsWith('Z')) rows.set(Number(row[1]), { parent: Number(row[2]), command: row[4] });
  }
  const targets = new Set();
  let runner;
  for (const [pid, row] of rows) {
    if (pid === process.pid) continue;
    if (row.command.includes(run)) targets.add(pid);
    if (row.command.includes(marker) && row.command.includes('--test')) runner = pid;
  }
  if (runner !== undefined) {
    targets.add(runner);
    let grew;
    do {
      grew = false;
      for (const [pid, row] of rows) {
        if (!targets.has(pid) && targets.has(row.parent)) {
          targets.add(pid);
          grew = true;
        }
      }
    } while (grew);
  }
  let pid;
  for (const line of read(LSOF, ['-nP', '-a', '-d', 'cwd', '-u', String(process.getuid()), '-Fpn']).split('\n')) {
    if (line.startsWith('p')) pid = Number(line.slice(1));
    if (line.startsWith('n') && inside(line.slice(1)) && pid !== process.pid && rows.has(pid)) targets.add(pid);
  }
  return [...targets].map((pid) => ({ pid, command: rows.get(pid)?.command ?? 'unknown' }));
}

async function closed() {
  await new Promise((resolve, reject) => {
    const input = createReadStream(pipe);
    input.on('error', reject);
    input.on('end', resolve);
    input.resume();
  });
}

try {
  await closed();
  const observed = new Map();
  for (let round = 0; round < SWEEPS; round += 1) {
    const left = processes();
    for (const target of left) {
      if (!observed.has(target.pid)) observed.set(target.pid, { ...target });
    }
    for (const { pid } of left) {
      try {
        process.kill(pid, 'SIGKILL');
      } catch (error) {
        if (error.code !== 'ESRCH') throw error;
      }
    }
    for (const [pid, target] of observed) {
      const current = targetState(pid);
      if (current.absent) observed.delete(pid);
      else if (target.started !== undefined && current.started !== target.started) throw new Error(`target ${pid} changed its coarse start identity; original ending remains unconfirmed`);
      else if (current.zombie) observed.delete(pid);
      else target.started ??= current.started;
    }
    if (left.length === 0 && observed.size === 0) {
      removeTemporaryDirectory(run);
      finishTrace();
      process.exit(0);
    }
  }
  throw new Error(`${SWEEPS} sweeps left these observed targets unconfirmed: ${JSON.stringify([...observed.values()])}; fresh census: ${JSON.stringify(processes())}`);
} catch (error) {
  console.error(`npm test reaper: ${error.stack ?? error}`);
  finishTrace();
  process.exitCode = 1;
}
