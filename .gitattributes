# ABOUTME: Line endings for the files whose format depends on them. A shell hook checked out with
# CRLF fails on its own shebang, so the hooks are pinned to LF wherever they are cloned.

.githooks/* text eol=lf

# A generated document is compared with what its tool produces, byte for byte, so the bytes in
# the working tree have to be the bytes the tool writes on every platform.
docs/derived/** text eol=lf
